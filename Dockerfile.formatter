FROM python:3.11-slim

# Install all Python quality and formatting tools
RUN pip install --no-cache-dir \
    black>=23.0.0 \
    isort>=5.12.0 \
    flake8>=6.1.0 \
    pylint>=3.0.0 \
    mypy>=1.7.0 \
    pyyaml>=6.0.1 \
    types-PyYAML>=6.0.12 \
    pytest>=7.4.0 \
    pytest-cov>=4.1.0

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-c"]
